# ---------------------------------------------------------------------------
# UNIS Equipment mobile app — example environment
# ---------------------------------------------------------------------------
# The mobile app ships sensible defaults in src/lib/config.ts (DEFAULTS). These
# EXPO_PUBLIC_* vars let you override them at build time without editing code.
# EXPO_PUBLIC_* values are embedded in the client bundle — never put secrets here.

# API base URL for the UNIS Equipment Hub.
EXPO_PUBLIC_API_BASE_URL=https://unis-equipment-performance-maintenance-hub.coolify.item.pub

# DEV-ONLY facility header override defaults. These are only used in __DEV__
# builds via the "Developer identity override" card in Settings. In production,
# identity comes from the Bearer token and these are ignored.
EXPO_PUBLIC_DEV_USER_ID=19708
EXPO_PUBLIC_DEV_USER_ROLES=admin
EXPO_PUBLIC_DEV_FACILITY_ID=LT_F1

# ---------------------------------------------------------------------------
# Backend (PROPOSED — for the Hub server, not the mobile app)
# ---------------------------------------------------------------------------
# Documented here so the mobile contract and the server config stay aligned.
#
# PostgreSQL connection.
# DATABASE_URL=postgres://user:pass@host:5432/unis_equipment
#
# CORS: comma-separated allow-list of origins permitted to call the API from a
# browser. Do NOT use "*" together with credentials. Native Expo apps are not
# subject to CORS; this only affects the web build / browser clients.
# CORS_ALLOWED_ORIGINS=https://your-web-app.example.com,http://localhost:8081
#
# Object storage for inspection photos (see docs/inspection-photo-upload.md).
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
#
# Token auth signing secret (see docs/mobile-authentication.md).
# AUTH_JWT_SECRET=
